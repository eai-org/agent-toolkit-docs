---
// Which icon shows is decided in CSS off <html data-theme>, so it is already right on first
// paint. The label below is the no-JS fallback, the script replaces it with the live one.
---
<button type="button" class="theme-toggle text-muted hover:text-green" aria-label="Switch color theme">
  <svg class="theme-icon theme-icon-dark" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d="M13.5 9.9A5.5 5.5 0 0 1 6.1 2.5 6.5 6.5 0 1 0 13.5 9.9Z" />
  </svg>
  <svg class="theme-icon theme-icon-light" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <circle cx="8" cy="8" r="3.25" />
    <path stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      d="M8 .9v1.8M8 13.3v1.8M.9 8h1.8M13.3 8h1.8M3 3l1.3 1.3M11.7 11.7 13 13M13 3l-1.3 1.3M4.3 11.7 3 13" />
  </svg>
  <svg class="theme-icon theme-icon-system" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M8 2.5a5.5 5.5 0 0 1 0 11Z" />
  </svg>
</button>

<script>
  const MODES = ['dark', 'light', 'system'] as const;
  type Mode = (typeof MODES)[number];

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
  const current = () => (MODES.includes(root.dataset.theme as Mode) ? (root.dataset.theme as Mode) : 'system');
  const next = (mode: Mode) => MODES[(MODES.indexOf(mode) + 1) % MODES.length];

  function apply(mode: Mode) {
    root.dataset.theme = mode;
    try {
      localStorage.setItem('theme', mode);
    } catch {} // storage can be blocked, the theme then just lasts for the page
    for (const btn of buttons) btn.setAttribute('aria-label', `Theme: ${mode}. Switch to ${next(mode)}.`);
  }

  apply(current());
  for (const btn of buttons) btn.addEventListener('click', () => apply(next(current())));
</script>
