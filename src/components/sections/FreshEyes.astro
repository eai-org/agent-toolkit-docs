---
import Section from '../Section.astro';
import DemoPlayer from '../DemoPlayer.astro';
interface Props { page?: boolean }
const { page = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Section kicker="Fresh eyes review" color="orange" heading="Let a sub-agent review the code" as={page ? 'h1' : 'h2'}>
  <p class="text-muted mb-4">
    A fresh perspective works for AI just like it does for humans: a sub-agent with a clean
    context, seeing only the changeset and a minimal description, catches surprisingly more
    regressions and issues than the session that wrote the code.
  </p>
  {page && <DemoPlayer cast="04-fresh-eyes" cols={72} rows={10} label="fresh-eyes-review returning three findings" />}
  {!page && (
    <p class="mt-4"><a class="more-link" href={`${base}/fresh-eyes-review/`}>More about the fresh eyes review &rarr;</a></p>
  )}
</Section>
