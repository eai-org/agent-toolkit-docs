---
import Section from '../Section.astro';
import DemoPlayer from '../DemoPlayer.astro';
---
<Section kicker="Conversational voice" color="blue" heading="Texts that sound like a real human typed them">
  <p class="text-muted">We often ask AI to help draft texts that other people will read:</p>
  <ul class="bullets my-4">
    <li><b class="sk">use-conversational-language</b> <span class="text-muted">tells the agent to write in simple, human language instead of sophisticated AI prose full of — em dashes — and fancy terms</span></li>
    <li><b class="sk">write-realistic-texts</b> <span class="text-muted">opt-in rule that applies the human voice automatically whenever a text is meant for other humans (code comments, PR replies, chat messages…)</span></li>
  </ul>
  <DemoPlayer cast="07-explain-refactor" cols={72} rows={16} label="use-conversational-language rewriting a refactor explanation" />
</Section>
