---
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={['terminal bg-panel border border-border rounded-card overflow-hidden text-left', cls]}>
  <div class="flex gap-1.5 px-4 pt-3 pb-1">
    <i class="w-2 h-2 rounded-full bg-pink"></i>
    <i class="w-2 h-2 rounded-full bg-orange"></i>
    <i class="w-2 h-2 rounded-full bg-green"></i>
  </div>
  <div class="px-4 pb-4"><slot /></div>
</div>
