---
interface Props {
  title: string;
  heading: string;
}
const { title, heading } = Astro.props;
---
<section class="text-center px-6 pt-14 pb-10">
  <h1 class="font-mono text-4xl font-extrabold">{title}</h1>
</section>
<section class="px-6 pb-10">
  <div class="max-w-page mx-auto">
    <h2 class="text-2xl font-bold mb-3">{heading}</h2>
    <slot />
  </div>
</section>
