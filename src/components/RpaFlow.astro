<div class="grid items-stretch gap-1.5 my-4 md:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr_auto_1fr]">
  <div class="stage border-border"><b class="text-muted">Ticket</b><span>download <b class="file">TICKET.md</b> from your tracking board or create it manually</span></div>
  <span class="arrow">&rarr;</span>
  <div class="stage border-green"><b class="text-green">Refine</b><span>defines the <b>WHAT</b> and outputs <b class="file">REQUIREMENTS.md</b></span></div>
  <span class="arrow">&rarr;</span>
  <div class="stage border-blue"><b class="text-blue">Plan</b><span>defines the <b>HOW</b> and outputs <b class="file">PLAN.md</b> with the implementation steps</span></div>
  <span class="arrow">&rarr;</span>
  <div class="stage border-orange"><b class="text-orange">Act</b><span>executes the plan, writing code and running checks</span></div>
  <span class="arrow">&rarr;</span>
  <div class="stage border-purple"><b class="text-purple">Consolidate</b><span>stabilizes the work: review with fresh eyes, then hand over the knowledge in <b class="file">HANDOVER.md</b></span></div>
</div>
