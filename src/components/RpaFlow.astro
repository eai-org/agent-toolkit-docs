<div class="grid items-stretch gap-1.5 my-4 lg:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr_auto_1fr]">
  <a href="#fetch-ticket" class="stage border-border no-underline"><b class="text-muted">Ticket</b><span>download <b class="file">TICKET.md</b> from your tracking board or create it manually</span></a>
  <span class="arrow">&rarr;</span>
  <a href="#refine-ticket" class="stage border-green no-underline"><b class="text-green">Refine</b><span>defines the <b>WHAT</b> and outputs <b class="file">REQUIREMENTS.md</b></span></a>
  <span class="arrow">&rarr;</span>
  <a href="#create-implementation-plan" class="stage border-blue no-underline"><b class="text-blue">Plan</b><span>defines the <b>HOW</b> and outputs <b class="file">PLAN.md</b>. Optional: <b class="file">/harden-artifact</b> checks it with fresh eyes</span></a>
