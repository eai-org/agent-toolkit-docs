---
import { starLabel } from '../lib/stars';
import ThemeToggle from './ThemeToggle.astro';
interface Props { back?: boolean }
const { back = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stars = await starLabel();
---
<nav class="sticky top-0 z-10 bg-bg/90 backdrop-blur border-b border-border">
  <div class="max-w-page mx-auto flex items-center justify-between gap-3 px-6 max-sm:px-4 py-3">
    <a href={`${base}/`} class="font-mono font-bold text-green no-underline whitespace-nowrap max-sm:text-[13px]">
      {back && <span aria-hidden="true" class="max-sm:hidden">&larr; </span>}agent-toolkit
    </a>
    <div class="flex items-center gap-4 max-sm:gap-2.5">
      <ThemeToggle />
      <a href={`${base}/skills/`} class="font-mono text-[13px] max-sm:text-[12px] text-text no-underline hover:text-green whitespace-nowrap">Skills</a>
      <a href={`${base}/about/`} class="font-mono text-[13px] max-sm:text-[12px] text-text no-underline hover:text-green whitespace-nowrap">About<span class="max-sm:hidden"> us</span></a>
      <a href="https://github.com/eai-org/agent-toolkit" aria-label="GitHub" class="font-mono text-[13px] max-sm:text-[12px] text-text no-underline hover:text-green whitespace-nowrap">
        <svg class="sm:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg><span class="max-sm:hidden">GitHub</span>{stars && <span class="text-muted max-md:hidden"> {stars}</span>}
      </a>
      <a href={`${base}/#install`} class="font-mono text-[13px] max-sm:text-[12px] font-bold text-bg bg-green rounded-md px-3 max-sm:px-2 py-1 no-underline whitespace-nowrap">Install</a>
    </div>
  </div>
</nav>
