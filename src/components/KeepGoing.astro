---
import GroupCard from './GroupCard.astro';
import { GROUPS } from '../data/groups';
---
<section class="px-6">
  <div class="max-w-page mx-auto border-t border-border py-10">
    <div class="grid md:grid-cols-3 gap-3">
      {GROUPS.map((group) => <GroupCard group={group} compact />)}
    </div>
  </div>
</section>
